# Endpoints come from `azd up` outputs (or `azd env get-values`). None of these
# are secrets: every Azure service below is reached with DefaultAzureCredential
# — Managed Identity in Container Apps, your `az login` locally.

COSMOS_ENDPOINT=https://cosmos-clausewatch-xxxx.documents.azure.com:443/
COSMOS_DATABASE=clausewatch

STORAGE_ACCOUNT_URL=https://stclausewatchxxxx.blob.core.windows.net/
CONTRACTS_CONTAINER=contracts

SERVICEBUS_NAMESPACE=sb-clausewatch-xxxx.servicebus.windows.net
INGEST_QUEUE=contract-ingest

DOC_INTELLIGENCE_ENDPOINT=https://di-clausewatch-xxxx.cognitiveservices.azure.com/
# prebuilt-layout gives structure without a trained model. prebuilt-contract
# adds contract-specific fields at a different price point — start with layout,
# measure, then decide.
DOC_INTELLIGENCE_MODEL=prebuilt-layout

# The one real secret here. The Anthropic Foundry client takes a key rather
# than a token credential, unlike every Azure service above. Keep it in Key
# Vault and inject it as a container secret; never commit a filled-in value.
FOUNDRY_RESOURCE=
FOUNDRY_API_KEY=
EXTRACTION_MODEL=claude-opus-5
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Bump whenever the extraction prompt changes. Stored on every obligation, so a
# bad batch can be found and re-run.
PROMPT_VERSION=v1

# Entra ID JWT validation. Leave both blank locally to disable enforcement;
# startup logs a warning when it is off. Any deployed revision must set both.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

DUE_SOON_DAYS=30
MIN_CONFIDENCE=0.35
LOG_LEVEL=INFO
ENVIRONMENT=local
